], [131.49499999999998, 113.53500000000001], [36.89, 113.53500000000001]], "bbox": [36.89, 100.91999999999999, 131.49499999999998, 113.53500000000001], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/18", "block_type": "Text", "html": "<p>Κεντρική Ένωση Επιμελητηρίων</p>", "polygon": [[36.89, 119.422], [172.54999999999998, 119.422], [172.54999999999998, 131.196], [36.89, 131.196]], "bbox": [36.89, 119.422, 172.54999999999998, 131.196], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/19", "block_type": "Text", "html": "<p>ΥΠΗΡΕΣΙΑ ΥΠΟΣΤΗΡΙΞΗΣ ΚΑΙ ΑΝΑΠΤΥΞΗΣ ΤΩΝ</p>", "polygon": [[36.89, 155.585], [232.05, 155.585], [232.05, 166.51800000000003], [36.89, 166.51800000000003]], "bbox": [36.89, 155.585, 232.05, 166.51800000000003], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/20", "block_type": "Text", "html": "<p>Αθήνα,26/06/2026</p>", "polygon": [[332.01, 153.903], [410.54999999999995, 153.903], [410.54999999999995, 164.836], [332.01, 164.836]], "bbox": [332.01, 153.903, 410.54999999999995, 164.836], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/21", "block_type": "Text", "html": "<p>ΠΛΗΡΟΦΟΡΙΑΚΩΝ ΣΥΣΤΗΜΑΤΩΝ Γ.Ε.ΜΗ. ΚΑΙ ΥΜΣ</p>", "polygon": [[36.89, 170.723], [251.68499999999997, 170.723], [251.68499999999997, 182.497], [36.89, 182.497]], "bbox": [36.89, 170.723, 251.68499999999997, 182.497], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/22", "block_type": "Text", "html": "<p>Αριθ. Πρωτ.:4131435</p>", "polygon": [[332.01, 169.04100000000003], [423.04499999999996, 169.04100000000003], [423.04499999999996, 181.656], [332.01, 181.656]], "bbox": [332.01, 169.04100000000003, 423.04499999999996, 181.656], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/23", "block_type": "Text", "html": "<p>Αρμόδια Υπηρεσία ΓΕΜΗ: ΕΜΠΟΡΙΚΟ &amp; ΒΙΟΜΗΧΑΝΙΚΟ</p>", "polygon": [[36.89, 188.38400000000001], [271.915, 188.38400000000001], [271.915, 200.999], [36.89, 200.999]], "bbox": [36.89, 188.38400000000001, 271.915, 200.999], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/24", "block_type": "Text", "html": "<p>ΕΠΙΜΕΛΗΤΗΡΙΟ ΑΘΗΝΩΝ</p>", "polygon": [[36.89, 205.204], [145.18, 205.204], [145.18, 216.97799999999998], [36.89, 216.97799999999998]], "bbox": [36.89, 205.204, 145.18, 216.97799999999998], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/25", "block_type": "Text", "html": "<p>Τηλέφωνο: 2103604815-9</p>", "polygon": [[36.89, 221.183], [146.37, 221.183], [146.37, 232.95700000000002], [36.89, 232.95700000000002]], "bbox": [36.89, 221.183, 146.37, 232.95700000000002], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/Text/26", "block_type": "Text", "html": "<p>E-mail: info@acci.gr</p>", "polygon": [[36.89, 237.16199999999998], [126.14, 237.16199999999998], [126.14, 249.777], [36.89, 249.777]], "bbox": [36.89, 237.16199999999998, 126.14, 249.777], "children": null, "section_hierarchy": {}, "images": {}}, {"id": "/page/0/SectionHeader/27", "block_type": "SectionHeader", "html": "<h3><u>ΑΝΑΚΟΙΝΩΣΗ</u></h3>", "polygon": [[261.205, 317.057], [335.5799999999999, 317.057], [335.5799999999999, 329.672], [261.205, 329.672]], "bbox": [261.205, 317.057, 335.5799999999999, 329.672], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/0/Text/28", "block_type": "Text", "html": "<p>Αυτοματοποιημένης Καταχώρισης στο Γενικό Εμπορικό Μητρώο (Γ.Ε.ΜΗ.), στοιχείων της Ανώνυμης Εταιρείας με την επωνυμία <b>ΦΑΓΕ Ελλάδας Βιομηχανία Γάλακτος Μονοπρόσωπη Α.Ε.</b>, το διακριτικό τίτλο <b>ΦΑΓΕ Ελλάδας Α.Ε</b> και αριθμό <b>ΓΕΜΗ 000306201000</b>.</p>", "polygon": [[38.675, 347.33299999999997], [561.0849999999999, 347.33299999999997], [561.0849999999999, 394.429], [38.675, 394.429]], "bbox": [38.675, 347.33299999999997, 561.0849999999999, 394.429], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/0/Text/29", "block_type": "Text", "html": "<p>Την <b>26/06/2026</b> καταχωρήθηκαν αυτοματοποιημένα στο Γενικό Εμπορικό Μητρώο (Γ.Ε.ΜΗ.) τα κατωτέρω στοιχεία:</p>", "polygon": [[33.915, 408.726], [511.10499999999996, 408.726], [511.10499999999996, 423.023], [33.915, 423.023]], "bbox": [33.915, 408.726, 511.10499999999996, 423.023], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/0/Text/30", "block_type": "Text", "html": "<p>Α) Με Κωδικό Αριθμό Καταχώρισης 6094251 οι εγκεκριμένες από την 24/06/2026 Γενική Συνέλευση οικονομικές καταστάσεις με τις σχετικές εκθέσεις όπου από την κείμενη νομοθεσία απαιτούνται για τη χρήση 01/01/2025 έως 31/12/2025.</p>", "polygon": [[33.915, 433.115], [561.0849999999999, 433.115], [561.0849999999999, 462.55000000000007], [33.915, 462.55000000000007]], "bbox": [33.915, 433.115, 561.0849999999999, 462.55000000000007], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/0/Text/31", "block_type": "Text", "html": "<p>Β) Με Κωδικό Αριθμό Καταχώρισης 6094252 η από 24/06/2026 απόφαση της Γενικής Συνέλευσης σύμφωνα με την οποία ορίστηκαν για τον έλεγχο των Οικονομικών καταστάσεων της χρήσης από 01/01/2026 έως 31/12/2026:</p>", "polygon": [[33.915, 480.211], [561.0849999999999, 480.211], [561.0849999999999, 511.328], [33.915, 511.328]], "bbox": [33.915, 480.211, 561.0849999999999, 511.328], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/0/ListGroup/32", "block_type": "ListGroup", "html": "<ul><li>- Η ελεγκτική εταιρεία «<b>ΕΡΝΣΤ &amp; ΓΙΑΝΓΚ (ΕΛΛΑΣ) Ορκωτοί Ελεγκτές Λογιστές Α.Ε.</b>», Α.Φ.Μ. 094316657-Δ.Ο.Υ. ΚΕΦΟΔΕ ΑΤΤΙΚΗΣ, Αρ. ΓΕΜΗ 710901000, και (Δ/νση : ΧΕΙΜΑΡΡΑΣ 8Β ΤΚ , ΑΘΗΝΑ), με αριθμό μητρώου ΣΟΕΛ 107.</li></ul>", "polygon": [[52.36, 528.148], [562.87, 528.148], [562.87, 574.403], [52.36, 574.403]], "bbox": [52.36, 528.148, 562.87, 574.403], "children": [], "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": null}, {"id": "/page/0/Text/33", "block_type": "Text", "html": "<p>Οι οικονομικές καταστάσεις με τις σχετικές εκθέσεις όπου από την κείμενη νομοθεσία απαιτούνται αποτελούν αναπόσπαστο μέρος της παρούσας ανακοίνωσης.</p>", "polygon": [[35.105, 629.909], [562.87, 629.909], [562.87, 660.1850000000001], [35.105, 660.1850000000001]], "bbox": [35.105, 629.909, 562.87, 660.1850000000001], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/0/Text/34", "block_type": "Text", "html": "", "polygon": [[36.89, 774.561], [446.25, 774.561], [446.25, 788.858], [36.89, 788.858]], "bbox": [36.89, 774.561, 446.25, 788.858], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/0/Text/35", "block_type": "Text", "html": "<p>Η παρούσα ανακοίνωση αποτελεί προϊόν αυτοματοποιημένης καταχώρισης δυνάμει της διάταξης του άρθρου 26 του ν.4919/2022 με μέριμνα και ευθύνη του υπόχρεου.</p>", "polygon": [[36.89, 789.699], [509.91499999999996, 789.699], [509.91499999999996, 821.657], [36.89, 821.657]], "bbox": [36.89, 789.699, 509.91499999999996, 821.657], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}], "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": null}, {"id": "/page/1/Page/9", "block_type": "Page", "html": "<content-ref src='/page/1/PageHeader/5'></content-ref><content-ref src='/page/1/SectionHeader/6'></content-ref><content-ref src='/page/1/Table/7'></content-ref><content-ref src='/page/1/Text/8'></content-ref><content-ref src='/page/1/PageFooter/9'></content-ref>", "polygon": [[0.0, 0.0], [595.3200073242188, 0.0], [595.3200073242188, 842.0399780273438], [0.0, 842.0399780273438]], "bbox": [0.0, 0.0, 595.3200073242188, 842.0399780273438], "children": [{"id": "/page/1/PageHeader/5", "block_type": "PageHeader", "html": "", "polygon": [[16.073640197753903, 34.52363909912109], [105.96696130371093, 34.52363909912109], [105.96696130371093, 45.47015881347656], [16.073640197753903, 45.47015881347656]], "bbox": [16.073640197753903, 34.52363909912109, 105.96696130371093, 45.47015881347656], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/1/SectionHeader/6", "block_type": "SectionHeader", "html": "<p>ΚΑΤΑΣΤΑΣΗ ΑΠΟΤΕΛΕΣΜΑΤΩΝ ΧΡΗΣΗΣ<br/>\n  ΓΙΑ ΤΗ ΧΡΗΣΗ ΠΟΥ ΕΛΗΞΕ ΤΗΝ 31° ΔΕΚΕΜΒΡΙΟΥ 2025<br/>\n  (Όλα τα ποσά είναι σε χιλιάδες ευρώ)</p>", "polygon": [[16.073640197753903, 63.15299835205077], [249.43908306884762, 63.15299835205077], [249.43908306884762, 95.15051751708984], [16.073640197753903, 95.15051751708984]], "bbox": [16.073640197753903, 63.15299835205077, 249.43908306884762, 95.15051751708984], "children": null, "section_hierarchy": {"3": "/page/0/SectionHeader/27"}, "images": {}}, {"id": "/page/1/Table/7", "block_type": "Table", "html": "<table>\n<thead>\n<tr>\n<th rowspan=\"2\">Σημειώσεις</th>\n<th colspan=\"2\">Για το έτος που έληξε στις<br/>31 Δεκεμβρίου,</th>\n</tr>\n<tr>\n<th>2025</th>\n<th>2024</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Κύκλος εργασιών</td>\n<td>205.619</td>\n<td>174.063</td>\n</tr>\n<tr>\n<td>Κόστος πωλήσεων</td>\n<td>(167.412)</td>\n<td>(143.470)</td>\n</tr>\n<tr>\n<td><b>Μικτά Κέρδη</b></td>\n<td><b>38.207</b></td>\n<td><b>30.593</b></td>\n</tr>\n<tr>\n<td>Έξοδα διοίκησης και διάθεσης</td>\n<td>5</td>\n<td>(26.775)</td>\n<td>(24.938)</td>\n</tr>\n<tr>\n<td>Λοιπά έσοδα εκμετάλλευσης</td>\n<td></td>\n<td>571</td>\n<td>451</td>\n</tr>\n<tr>\n<td>Λοιπά έξοδα εκμετάλλευσης</td>\n<td>24</td>\n<td>(5.535)</td>\n<td>(23.907)</td>\n</tr>\n<tr>\n<td><b>ΚΕΡΑΗ/(ΖΗΜΙΕΣ)<br/>ΕΚΜΕΤΑΛΛΕΥΣΗΣ</b></td>\n<td></td>\n<td><b>6.468</b></td>\n<td><b>(17.801)</b></td>\n</tr>\n<tr>\n<td>Χρηματοοικονομικά έξοδα</td>\n<td>6</td>\n<td>(1.480)</td>\n<td>(1.647)</td>\n</tr>\n<tr>\n<td>Χρηματοοικονομικά έσοδα</td>\n<td>6</td>\n<t